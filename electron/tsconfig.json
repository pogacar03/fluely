{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "outDir": "../dist-electron",
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../src/shared/**/*.ts", "../src/renderer/workspace-navigation.ts"]
}
